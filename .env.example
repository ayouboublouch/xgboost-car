# ==============================================================================
# Autohouse.ma - Notification & Cloud Configuration
# ==============================================================================

# Telegram Bot API (Recommended: Instant setup, rich HTML formatting, free)
# 1. Message @BotFather on Telegram and send /newbot to obtain your bot token
# 2. Message @userinfobot on Telegram to get your numerical Chat ID
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"

# WhatsApp API via CallMeBot free webhook (Optional)
# 1. Add +34 644 44 20 62 to WhatsApp contacts
# 2. Send "I allow callmebot to send me messages"
# 3. Paste the returned API key below
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE="212640926052"
WHATSAPP_API_KEY=""

# Scraping & Ingestion Settings
SCRAPER_HEADLESS="true"
SCRAPER_TIMEOUT_SECONDS="30"
